# 运行模式：development | production | test
NODE_ENV=development
# 监听端口
PORT=8080
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 对外访问地址（OAuth 回调、评论里的面板链接都以它为准）
PUBLIC_URL=http://localhost:5173
# 目标仓库 owner/name
GITHUB_REPO=CFPAOrg/Minecraft-Mod-Language-Package

# GitHub App（优先级最高，三者齐全时使用 App 模式）
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=config/app.pem

# Webhook 密钥（未配置时 /api/webhook 返回 503）
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth App（未配置时无法登录面板）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Personal Access Token（无 App 凭据时的回退；两者都没有则匿名只读）
GITHUB_PAT=

# Bot 账号名（评论作者判定）
BOT_LOGIN=cfpa-bot[bot]

# CurseForge API Key（未配置时跳过 CurseForge 查询与映射扫描）
CURSEFORGE_API_KEY=

# 术语查询工具可执行文件（未配置时 glossary 工具报告不可用）
GLOSSARY_BIN=

# 仅开发模式生效：把每个请求当作该账号的仓库管理员
DEV_LOGIN=
