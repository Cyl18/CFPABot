{
  "name": "cfpa-agent",
  "private": true,
  "type": "module",
  "workspaces": ["web", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun --watch server/main.ts\" \"bun run --cwd web dev\"",
    "dev:server": "bun --watch server/main.ts",
    "build": "bun run --cwd web build && bun build server/main.ts --outdir dist --target bun --external omp-legacy-pi-modules && bun scripts/copy-natives.ts",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit -p . && bun run --cwd web typecheck",
    "test": "bun test server && bun test packages/review-core"
  },
  "dependencies": {
    "@cfpa/contracts": "workspace:*",
    "@cfpa/review-core": "workspace:*",
    "@octokit/auth-app": "8.3.1",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks-methods": "6.0.0",
    "@oh-my-pi/omptype": "18.12.3",
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-coding-agent": "18.12.3",
    "diff": "^9.0.0",
    "fflate": "0.8.3",
    "hono": "4.13.10",
    "jsonc-parser": "^3.3.1",
    "lru-cache": "^11.5.3",
    "p-map": "^7.0.8",
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  }
}
