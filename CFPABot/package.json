{
  "name": "cfpabot",
  "module": "src/index.ts",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun --watch src/index.ts\" \"cd web && bun run dev\"",
    "build": "bun run --cwd=web build && bun build src/index.ts --outdir dist --target bun --minify",
    "start": "bun run dist/index.js",
    "lint:arch": "bun run scripts/lint-arch.ts",
    "fetch:glossary": "bun run scripts/fetch-glossary.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:web": "bun run --cwd=web test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modrinth/api-client": "^0.30.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^12.0.0",
    "@xmcl/curseforge": "^2.2.0",
    "hono": "^4.12.28",
    "jschardet": "^3.1.4",
    "pi-mcp-adapter": "^2.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typebox": "1.1.38",
    "unzipit": "^2.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@octokit/types": "^16.0.0",
    "bun-types": "latest",
    "concurrently": "^10.0.3",
    "typescript": "^5.7.0"
  }
}
