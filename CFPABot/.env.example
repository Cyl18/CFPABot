# ─── Required ───
GITHUB_WEBHOOK_SECRET=         # HMAC verify for webhooks

# ─── GitHub App Authentication (replaces PAT for GitHub API calls) ───
GITHUB_APP_ID=                 # GitHub App ID
GITHUB_APP_INSTALLATION_ID=    # Installation ID
# GITHUB_APP_PEM_PATH=config/cfpa-bot.pem   # Path to RSA private key (default: config/cfpa-bot.pem)

# ─── Server ───
# PORT=8080
# ASPNETCORE_ENVIRONMENT=Development  # Dev mode: auto-admin, skip OAuth
# LOG_LEVEL=info                      # debug | info | warn | error

# ─── Optional ───
# GITHUB_OAUTH_TOKEN=            # PAT for personal-scoped ops (Gist, GraphQL). Falls back to unauthenticated if unset.
# OAUTH_CLIENT_ID=              # GitHub OAuth App — user login on frontend
# OAUTH_CLIENT_SECRET=           # GitHub OAuth App secret
# LOCAL_REPO_PATH=../minecraft/Minecraft-Mod-Language-Package  # 本地仓库路径，用于本地文件读取（开发/生产）
# CF_API_KEY=                    # CurseForge mod name resolution

