{
  "name": "cfpa-agent",
  "private": true,
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun --watch server/main.ts\" \"bun run --cwd web dev\"",
    "dev:server": "bun --watch server/main.ts",
    "build": "bun run --cwd web build && bun build server/main.ts --outdir dist --target bun",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit -p . && bun run --cwd web typecheck",
    "test": "bun test server"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@octokit/auth-app": "8.3.1",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks-methods": "6.0.0",
    "fflate": "0.8.3",
    "hono": "4.13.10",
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  }
}
